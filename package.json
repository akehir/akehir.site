{
  "name": "akehir.com",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 5555 --host 0.0.0.0",
    "build": "ng build --configuration production --progress=false",
    "test": "ng test --no-watch",
    "test:docker": "ng test --no-watch --progress=false --code-coverage --browsers ChromeDocker",
    "lint": "ng lint && npm run lint:sass",
