{
  "name": "akehir.com",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "ake": "npm run lint:fix && npm run publish",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production --progress=false",
    "build:ssg": "ng build --configuration production --progress=false",
    "serve:ssg": "node dist/akehir/server/server.mjs",
    "test": "ng test --no-watch",
    "test:docker": "ng test --no-watch --progress=false --browsers ChromeDocker",
    "lint": "prettier --check \"**/*.{ts,js,html,scss,json,md}\" && ng lint",
    "lint:fix": "prettier --write \"**/*.{ts,js,html,scss,json,md}\" && ng lint akehir --fix",
    "prerender": "node ./tools/generate-prerender-routes.mjs",
    "rss": "node ./tools/generate-rss-feed.mjs",
    "sitemap": "node ./tools/generate-sitemap.mjs",
    "publish": "npm run sitemap && npm run rss && npm run prerender",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "@triangular/fluid-simulation": "^22.0.0",
    "@triangular/font-awesome-icons": "^22.0.1",
    "@triangular/noto-emoji-icons": "^22.0.1",
    "@triangular/rpg-awesome-icons": "^22.0.1",
    "express": "^4.22.2",
    "katex": "^0.16.47",
    "marked": "^18.2.0",
    "marked-katex-extension": "^5.1.13",
    "ngx-markdown": "^22.1.1",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/jasmine": "~6.0.0",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^26.6.6",
    "@types/webgl2": "~0.0.12",
    "angular-eslint": "22.6.0",
    "eslint": "^10.15.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
