    "@angular/platform-browser-dynamic": "^18.0.2",
    "@angular/router": "^18.0.2",
    "@triangular/fluid-simulation": "^11.0.0",
    "@triangular/font-awesome-icons": "^10.0.1",
    "@triangular/noto-emoji-icons": "^10.0.1",
    "@triangular/rpg-awesome-icons": "^10.0.1",
    "core-js": "^3.26.1",
    "rxjs": "~7.5.7",
    "tslib": "^2.4.1",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
