{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "types": ["webgl2"]
  },
  "files": ["main.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
